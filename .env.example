# 이 파일을 복사해서 .env로 저장한 뒤, 필요하면 값을 바꿔서 사용한다.
#   cp .env.example .env
# .env는 비밀번호가 들어갈 수 있으므로 .gitignore 대상 (커밋 금지).
# .env가 없어도 docker-compose.yml의 기본값으로 동작한다.

MYSQL_DATABASE=jeongbobada
MYSQL_USER=jeongbobada
MYSQL_PASSWORD=jeongbobada
MYSQL_ROOT_PASSWORD=root

# 호스트 포트. 로컬에 MySQL이 이미 3306으로 떠 있으면 3307 등으로 바꾼다.
MYSQL_PORT=3306
BACKEND_PORT=8080

# 워터마크 엔진 주소. 기본값은 호스트에서 실행 중인 엔진(:8000)
ENGINE_URL=http://host.docker.internal:8000

# 업로드 파일 AES-256-GCM 암호화 키 (base64 32바이트, 필수). 생성: openssl rand -base64 32
FILE_ENCRYPTION_KEY=

# 프론트엔드 출처 (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# dev 프로필이면 기동 시 시드 데이터(엔진 필요)를 만든다. 운영은 비워 둔다
SPRING_PROFILES_ACTIVE=dev
